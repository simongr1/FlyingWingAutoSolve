# -*- coding: utf-8 -*-

# Macro Begin: /home/eprice/.local/share/FreeCAD/Macro/WingSolver_AnalyseResult.FCMacro +++++++++++++++++++++++++++++++++++++++++++++++++
import FreeCAD


import numpy as np
import scipy as sp
import math
import re
import WingSolver_dependencies.WingSolver_Dependencies as wd


desc=FreeCAD.ActiveDocument.getObjectsByLabel("ResultDescription")[0]
raw=FreeCAD.ActiveDocument.getObjectsByLabel("RawResultData")[0]
res=FreeCAD.ActiveDocument.getObjectsByLabel("ResultData")[0]
geometry=FreeCAD.ActiveDocument.getObjectsByLabel("WingGeometry")[0]
computed=FreeCAD.ActiveDocument.getObjectsByLabel("ComputedValues")[0]

paramnames=desc.cells[desc.cells["ParameterNames"]]
paramfields=desc.cells[desc.cells["Fields"]]
paramapprox=desc.cells[desc.cells["Approx"]]
paramref=desc.cells[desc.cells["Ref"]]
params={}
for i in range(len(paramnames)):
	params[paramnames[i]]={"name":paramnames[i],"rank":paramapprox[i],"ref":paramref[i], "data":np.array(raw.cells[paramfields[i]])}

for param in params.values():
	if param["ref"] in paramnames:
		
		if param["name"]=="PitchTorque":
			#special case for pitch torque. We only want the zero value and two more on each side.
			#The first point is from the raw data is ignored
			middle_index=4 #the 4th(index) point is on y axis
			width_index=2 #additional 2 points on each side
			left_index= middle_index-width_index
			rigth_index= middle_index+width_index+1
			param["refdata"]=params[param["ref"]]["data"]
			fit=np.polyfit(param["refdata"][left_index:rigth_index],param["data"][left_index:rigth_index],param["rank"])
			
		else:
			param["refdata"]=params[param["ref"]]["data"]
			fit=np.polyfit(param["refdata"],param["data"],param["rank"])
		param["center"]=0
		param["slope"]=1.0
		if (param["rank"]==1): # its a line - get slope and zero point crossing
			param["center"]=-fit[1]/fit[0]
			param["slope"]=fit[0]
		elif (param["rank"]==2): # this is for drag - get the point of minimum drag and how quickly it increases
			param["center"]=-fit[1]/(2*fit[0]) #vertex of parabola
			param["slope"]=2*fit[0]
		elif (param["rank"]==3): # this is for lift - a sine wave
			roots=np.roots(fit)
			reals=roots[np.isreal(roots)]
			best=np.inf
			for r in reals:
				if np.abs(r)<np.abs(best):
					best=r
			param["center"]=best
			param["slope"]=3.*fit[0]*best**2 + 2*fit[1]*best + fit[2] # derivative
		param["ZeroValue"]=fit[-1]
		res.set(param["name"]+"Parameters","tuple"+str(tuple([ float(x) for x in fit ])))
		#res.set(param["name"]+"Parameters","=tuple"+str(tuple(fit)))
		res.set(param["name"]+"Center","%E"%param["center"]) #(root of the polynomial
		res.set(param["name"]+"Slope","%E"%param["slope"])
		res.set(param["name"]+"ZeroValue","%E"%fit[-1])

#calculate Drag Polar
AIR_DENSITY=1.2
GRAVITY_CONSTANT=9.81
velocity=geometry.get("Velocity")
v_target=velocity
area_msq=geometry.get("WingArea")*1e-6
mass_kg=computed.get("TotalMass")
lift_force_N=params["LiftForce"]["data"]
drag_force_N=params["DragForce"]["data"]
lift_coefficient=wd.total_to_coefficient(lift_force_N,AIR_DENSITY,velocity,area_msq)
drag_coefficient=wd.total_to_coefficient(drag_force_N,AIR_DENSITY,velocity,area_msq)
drag_curve_poly=wd.drag_curve(lift_coefficient,drag_coefficient)
res.set("DragPolarParameters","tuple"+str(tuple([ float(x) for x in drag_curve_poly ])))


#Cost Function 2
#Calculate Costs 
#Lift and drag
c_L_bestendurance, c_D_bestendurance= wd.cL_cD_bestendurance(drag_curve_poly)

Weigth_N=mass_kg*GRAVITY_CONSTANT
c_g=Weigth_N/(0.5*AIR_DENSITY*v_target**2*area_msq)
Lift_zero_N= params["LiftForce"]["ZeroValue"]
Drag_zero_N= params["DragForce"]["ZeroValue"]

#pitch stability
#in trimmed position alpha=0
pitch_torque_trimmed_fligth=res.get("PitchTorqueZeroValue") # must be zero
#calculate static margin:
staticMarginGoal=0.12
TaperRatio=geometry.get("TaperRatio")
RootChord=geometry.get("RootChord")
meanChordLength_mm=2/3*RootChord*(1+TaperRatio+TaperRatio**2)/(1+TaperRatio)
alphaZeroLift=params["LiftForce"]["center"]
pitch_torque_AC=np.polyval(wd.extract_tupel(res.get("PitchTorqueParameters")),alphaZeroLift) #evalute pitch torque at zero lift angle

try:
	#catch possible division by zero
	liftForcePoly=wd.extract_tupel(res.get("LiftForceParameters"))
	pitchTorquePoly=wd.extract_tupel(res.get("PitchTorqueParameters"))
	xPositionaAC_reverse_m=(pitch_torque_AC-pitchTorquePoly[-1])/liftForcePoly[-1] #calculate ac position for alpha=0
	
except: 
	print("division by zero, use different point for stability calculation")
	i=int(len(lift_force_N)/2) #take middle value
	xPositionaAC_reverse_m=(pitch_torque_AC-params["PitchTorque"]["data"][i])/lift_force_N[i]

staticMargin= xPositionaAC_reverse_m/(meanChordLength_mm*1e-3)

#Error calculation
#Lift_diff= (-1/(0.05*c_g)*(c_a_bestendurance-c_g))**2 #5% deviation allowed
Lift_diff= (-1/(0.01*Weigth_N)*(Lift_zero_N-Weigth_N))**2 #5% deviation allowed
static_margin_diff=(-1/(0.1*staticMarginGoal)*(staticMargin-staticMarginGoal))**2 #10% devaition allowed
pitch_torque_trimmed_diff=(0.5-pitch_torque_trimmed_fligth+1)**2 #when below 0.5Nm allowed
#must be zero
Drag_diff=(Drag_zero_N*3)**2 #~1.8N -> 3.5N times two increase the error

Drag_diff=0 #only optimize for the other results
cost=Lift_diff+static_margin_diff+pitch_torque_trimmed_diff+Drag_diff
res.set("LiftGoal","%E"%Weigth_N)
res.set("DragGoal","%E"%0)
res.set("StaticMarginGoal","%E"%staticMarginGoal)
res.set("TrimGoal","%E"%0.5)
res.set("LiftCurrent","%E"%Lift_zero_N)
res.set("DragCurrent","%E"%Drag_zero_N)
res.set("StaticMarginCurrent","%E"%staticMargin)
res.set("TrimCurrent","%E"%pitch_torque_trimmed_fligth)
res.set("LiftCost","%E"%Lift_diff)
res.set("DragCost","%E"%Drag_diff)
res.set("StaticMarginCost","%E"%static_margin_diff)
res.set("TrimCost","%E"%pitch_torque_trimmed_diff)

res.set("TotalCost","%E"%cost)


FreeCAD.ActiveDocument.recompute()

