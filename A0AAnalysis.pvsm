    <Proxy group="filters" type="ProgrammableFilter" id="24425" servers="1">
      <Property name="CopyArrays" id="24425.CopyArrays" number_of_elements="1">
        <Element index="0" value="0"/>
        <Domain name="bool" id="24425.CopyArrays.bool"/>
      </Property>
      <Property name="InformationScript" id="24425.InformationScript" number_of_elements="1">
