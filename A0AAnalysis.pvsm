      <Property name="Input" id="24425.Input" number_of_elements="2">
        <Proxy value="23892" output_port="0"/>
        <Proxy value="22690" output_port="0"/>
        <Domain name="groups" id="24425.Input.groups"/>
        <Domain name="input_type" id="24425.Input.input_type"/>
      </Property>
      <Property name="OutputDataSetType" id="24425.OutputDataSetType" number_of_elements="1">
        <Element index="0" value="8"/>
        <Domain name="enum" id="24425.OutputDataSetType.enum">
          <Entry value="8" text="Same as Input"/>
          <Entry value="0" text="vtkPolyData"/>
          <Entry value="2" text="vtkStructuredGrid"/>
          <Entry value="3" text="vtkRectilinearGrid"/>
          <Entry value="4" text="vtkUnstructuredGrid"/>
          <Entry value="6" text="vtkImageData"/>
          <Entry value="10" text="vtkUniformGrid"/>
          <Entry value="13" text="vtkMultiblockDataSet"/>
          <Entry value="15" text="vtkHierarchicalBoxDataSet"/>
          <Entry value="32" text="vtkHyperTreeGrid"/>
          <Entry value="19" text="vtkTable"/>
          <Entry value="33" text="vtkMolecule"/>
          <Entry value="37" text="vtkPartitionedDataSet"/>
          <Entry value="38" text="vtkPartitionedDataSetCollection"/>
        </Domain>
      </Property>
      <Property name="PythonPath" id="24425.PythonPath" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Script" id="24425.Script" number_of_elements="1">
        <Element index="0" value="CP=inputs[1].GetPoints()&#xa;F=inputs[1].PointData[&#x27;F&#x27;][0]&#xa;M=inputs[1].PointData[&#x27;M&#x27;][0]&#xa;U=inputs[0].PointData[&#x27;U&#x27;][0]&#xa;&#xa;&#xa;#U=numpy.array((-1,-1,0)) #debug&#xa;mass_density=1.2 &#xa;u2=numpy.linalg.norm(U)**2&#xa;q=0.5*mass_density*u2&#xa;&#xa;D0=-U/numpy.linalg.norm(U)&#xa;S00=numpy.array((0,1,0))&#xa;L0=numpy.cross(D0,S00)&#xa;L0=L0/numpy.linalg.norm(L0)&#xa;S0=numpy.cross(L0,D0)&#xa;&#xa;L1=numpy.dot(L0,F)&#xa;D1=numpy.dot(D0,F)&#xa;S1=numpy.dot(S0,F)&#xa;output.PointData.append(numpy.array((D1,S1,L1)),&#x27;AF&#x27;)&#xa;output.PointData.append(F,&#x27;F&#x27;)&#xa;output.PointData.append(numpy.array((M[0],-M[1],-M[2])),&#x27;M&#x27;)&#xa;&#xa;cL=L1/q&#xa;cD=-D1/q&#xa;output.PointData.append(cL,&#x27;cL&#x27;)&#xa;output.PointData.append(cD,&#x27;cD&#x27;)&#xa;#output.PointData.append(S0,&#x27;slip_dir&#x27;)&#xa;#output.PointData.append(L0,&#x27;lift_dir&#x27;)&#xa;#output.PointData.append(numpy.array((D0,S0,L0)),&#x27;ref&#x27;)&#xa;"/>
      </Property>
      <Property name="TimestepValues" id="24425.TimestepValues" number_of_elements="10">
        <Element index="0" value="100"/>
        <Element index="1" value="200"/>
        <Element index="2" value="300"/>
        <Element index="3" value="400"/>
        <Element index="4" value="500"/>
        <Element index="5" value="600"/>
        <Element index="6" value="700"/>
        <Element index="7" value="800"/>
        <Element index="8" value="900"/>
        <Element index="9" value="1000"/>
      </Property>
      <Property name="UpdateExtentScript" id="24425.UpdateExtentScript" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
    </Proxy>
