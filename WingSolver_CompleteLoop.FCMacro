import FreeCAD
import FreeCADGui

from os import path
from CfdOF.Mesh import CfdMeshTools
from CfdOF import CfdTools
import re
import math
import shutil
import time
from datetime import timedelta




mydir = path.dirname(__file__)

desc=FreeCAD.ActiveDocument.getObjectsByLabel("ParameterDescription")[0]
sstate=FreeCAD.ActiveDocument.getObjectsByLabel("SolverState")[0]
scontrol=FreeCAD.ActiveDocument.getObjectsByLabel("SolverControl")[0]

basedir=desc.cells["BaseDir"]
workingdirbase=path.join(basedir,"workingdir")
resultdirbase=os.path.join(basedir,"results")

prepareNextStepMacro=path.join(mydir, 'WingSolver_PrepareNextStep.FCMacro')
calcGradientMacro=path.join(mydir, 'WingSolver_CalcGradient.FCMacro')
plotResultMacro=path.join(mydir, 'WingSolver_PlotResult.FCMacro')
outerLoopMarcro=path.join(mydir, 'WingSolver_OuterLoop.FCMacro')
resetDefaultsMacro=path.join(mydir, 'WingSolver_ResetDefaults.FCMacro')





paramnames=desc.cells[desc.cells["ParameterNames"]]


CfdTools.executeMacro(resetDefaultsMacro)
CfdTools.executeMacro(calcGradientMacro)
#copy all the folders to results 1
print("Collecting results:")
outputfoldername=os.path.join(resultdirbase,str(1))
for p in ("0",)+paramnames:
    subfolder=os.path.join(outputfoldername,p)
    srcfolder=os.path.join(workingdirbase,p)
    os.makedirs(subfolder,exist_ok=True)
    for f in ("rawresult.csv","result.csv","parameters.csv","geometry.csv","mass.csv"):
        srcfile=os.path.join(srcfolder,f)
        dstfile=os.path.join(subfolder,f)
        try:
            shutil.copy(srcfile,dstfile)
        except Exception as e:
            print("Could not copy file %s, %s"%(srcfile,str(e)))
CfdTools.executeMacro(outerLoopMarcro)

desc=FreeCAD.ActiveDocument.getObjectsByLabel("ParameterDescription")[0]
sstate=FreeCAD.ActiveDocument.getObjectsByLabel("SolverState")[0]
scontrol=FreeCAD.ActiveDocument.getObjectsByLabel("SolverControl")[0]



paramnames=desc.cells[desc.cells["ParameterNames"]]



